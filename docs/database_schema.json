{
  "$schema": "OrignaGTA Firestore Database Schema",
  "version": "1.0.0",
  "lastUpdated": "2026-01-29",
  "description": "Complete Firestore database schema for OrignaGTA e-commerce platform",

  "collections": {
    "users": {
      "description": "User accounts including buyers, sellers, and admins",
      "documentId": "{userId} - Firebase Auth UID",
      "fields": {
        "uid": {
          "type": "string",
          "required": true,
          "description": "Firebase Auth User ID"
        },
        "email": {
          "type": "string",
          "required": true,
          "description": "User email address"
        },
        "name": {
          "type": "string",
          "required": true,
          "description": "User display name"
        },
        "roles": {
          "type": "array<string>",
          "required": true,
          "description": "User roles: 'admin', 'seller', 'assistant'",
          "values": ["admin", "seller", "assistant"]
        },
        "address": {
          "type": "map",
          "required": false,
          "description": "User's default address",
          "schema": "$ref:Address"
        },
        "createdAt": {
          "type": "timestamp",
          "required": true,
          "description": "Account creation timestamp"
        },
        "customerId": {
          "type": "string",
          "required": false,
          "description": "Stripe Customer ID for payments"
        },
        "lastCheckoutSession": {
          "type": "string",
          "required": false,
          "description": "Last Stripe Checkout Session ID"
        },
        "lastOrderId": {
          "type": "string",
          "required": false,
          "description": "Last created order ID"
        },
        "lastCheckoutTimestamp": {
          "type": "timestamp",
          "required": false,
          "description": "Timestamp of last checkout"
        },
        "stripeAccountId": {
          "type": "string",
          "required": false,
          "description": "Stripe Connect account ID (for sellers)"
        },
        "payoutsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether seller can receive payouts"
        },
        "chargesEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether seller can accept charges"
        },
        "onboardingCompleted": {
          "type": "boolean",
          "default": false,
          "description": "Whether Stripe Connect onboarding is complete"
        },
        "updatedAt": {
          "type": "timestamp",
          "required": false,
          "description": "Last update timestamp"
        }
      },
      "subcollections": {
        "cart": {
          "description": "User's shopping cart items",
          "documentId": "{productId}",
          "fields": {
            "productId": {
              "type": "string",
              "required": true,
              "description": "Reference to product document"
            },
            "quantity": {
              "type": "number",
              "required": true,
              "description": "Quantity in cart"
            },
            "dateCreated": {
              "type": "timestamp",
              "required": true,
              "description": "When item was added to cart"
            }
          }
        },
        "favorites": {
          "description": "User's favorited products",
          "documentId": "{productId}",
          "fields": {
            "productId": {
              "type": "string",
              "required": true,
              "description": "Reference to product document"
            },
            "dateFavorited": {
              "type": "timestamp",
              "required": true,
              "description": "When product was favorited"
            }
          }
        }
      },
      "indexes": [
        {
          "fields": ["stripeAccountId"],
          "description": "For looking up users by Stripe Connect account"
        }
      ]
    },

    "products": {
      "description": "Product listings",
      "documentId": "{auto-generated}",
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Product name"
        },
        "price": {
          "type": "number",
          "required": true,
          "description": "Price in CAD"
        },
        "description": {
          "type": "string",
          "required": true,
          "description": "Product description"
        },
        "imageUrls": {
          "type": "array<string>",
          "required": true,
          "description": "Product image URLs (max 5)"
        },
        "sellerId": {
          "type": "string",
          "required": true,
          "description": "Reference to seller's user document"
        },
        "sellerAddress": {
          "type": "map",
          "required": true,
          "description": "Seller's shipping address",
          "schema": "$ref:Address"
        },
        "categoryId": {
          "type": "number",
          "required": true,
          "description": "Product category (1-21)"
        },
        "stockQuantity": {
          "type": "number",
          "required": true,
          "description": "Available stock (0 = sold out)"
        },
        "rating": {
          "type": "number",
          "default": 0.0,
          "description": "Average rating (0-5)"
        },
        "ratingCount": {
          "type": "number",
          "default": 0,
          "description": "Number of ratings received"
        },
        "searchKeywords": {
          "type": "array<string>",
          "required": true,
          "description": "Keywords for search functionality"
        },
        "dateCreated": {
          "type": "timestamp",
          "required": true,
          "description": "Product creation date"
        }
      },
      "indexes": [
        {
          "fields": ["sellerId", "dateCreated"],
          "description": "For seller's product listings"
        },
        {
          "fields": ["categoryId", "dateCreated"],
          "description": "For category browsing"
        },
        {
          "fields": ["searchKeywords"],
          "description": "For product search"
        }
      ]
    },

    "orders": {
      "description": "Customer orders",
      "documentId": "{auto-generated}",
      "fields": {
        "userId": {
          "type": "string",
          "required": true,
          "description": "Buyer's user ID"
        },
        "customerEmail": {
          "type": "string",
          "required": true,
          "description": "Customer email for notifications"
        },
        "customerId": {
          "type": "string",
          "required": false,
          "description": "Stripe Customer ID"
        },
        "items": {
          "type": "array<map>",
          "required": true,
          "description": "Order items with delivery tracking",
          "schema": "$ref:OrderItem"
        },
        "sellerIds": {
          "type": "array<string>",
          "required": true,
          "description": "Unique seller IDs in this order"
        },
        "subtotal": {
          "type": "number",
          "required": true,
          "description": "Sum of item prices"
        },
        "taxes": {
          "type": "map<string, number>",
          "required": true,
          "description": "Tax breakdown (GST, PST, HST, QST)"
        },
        "shippingCost": {
          "type": "number",
          "required": true,
          "description": "Calculated shipping cost"
        },
        "total": {
          "type": "number",
          "required": true,
          "description": "Grand total (subtotal + taxes + shipping)"
        },
        "amount": {
          "type": "number",
          "required": true,
          "description": "Amount in cents for Stripe"
        },
        "currency": {
          "type": "string",
          "default": "cad",
          "description": "Currency code"
        },
        "status": {
          "type": "string",
          "required": true,
          "description": "Order status",
          "values": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled", "failed", "expired", "refunded", "partially_refunded"]
        },
        "paymentStatus": {
          "type": "string",
          "required": true,
          "description": "Payment status",
          "values": ["awaiting_payment", "processing", "paid", "payment_failed", "refunded", "session_expired"]
        },
        "deliveryInfo": {
          "type": "map",
          "required": true,
          "description": "Delivery address details",
          "schema": "$ref:Address"
        },
        "stripeSessionId": {
          "type": "string",
          "required": false,
          "description": "Stripe Checkout Session ID"
        },
        "stripePaymentIntentId": {
          "type": "string",
          "required": false,
          "description": "Stripe Payment Intent ID"
        },
        "createdAt": {
          "type": "timestamp",
          "required": true,
          "description": "Order creation timestamp"
        },
        "updatedAt": {
          "type": "timestamp",
          "required": false,
          "description": "Last update timestamp"
        },
        "confirmedByClient": {
          "type": "boolean",
          "default": false,
          "description": "Buyer confirmed receipt of all items"
        },
        "confirmedAt": {
          "type": "timestamp",
          "required": false,
          "description": "When order was confirmed by buyer"
        },
        "autoConfirmed": {
          "type": "boolean",
          "default": false,
          "description": "Whether confirmation was automatic after 14 days"
        },
        "sellerPayouts": {
          "type": "array<map>",
          "required": false,
          "description": "Per-seller payout breakdown",
          "schema": "$ref:SellerPayout"
        },
        "platformFeeTotal": {
          "type": "number",
          "default": 0,
          "description": "Total platform fee collected (2.5%)"
        },
        "payoutStatus": {
          "type": "string",
          "default": "pending",
          "description": "Payout status",
          "values": ["pending", "processing", "completed", "partial", "failed"]
        },
        "ratings": {
          "type": "map<string, number>",
          "required": false,
          "description": "Product ratings by productId"
        },
        "refundAmount": {
          "type": "number",
          "required": false,
          "description": "Amount refunded if applicable"
        },
        "refundedAt": {
          "type": "timestamp",
          "required": false,
          "description": "When refund was processed"
        }
      },
      "indexes": [
        {
          "fields": ["userId", "paymentStatus", "createdAt desc"],
          "description": "For buyer's order history"
        },
        {
          "fields": ["sellerIds", "paymentStatus", "createdAt desc"],
          "description": "For seller's order view"
        },
        {
          "fields": ["paymentStatus", "confirmedByClient", "payoutStatus"],
          "description": "For auto-release payout job"
        },
        {
          "fields": ["stripePaymentIntentId"],
          "description": "For webhook lookups"
        },
        {
          "fields": ["stripeSessionId"],
          "description": "For checkout completion"
        }
      ]
    },

    "webhook_logs": {
      "description": "Audit trail for Stripe webhook events",
      "documentId": "{auto-generated}",
      "fields": {
        "eventId": {
          "type": "string",
          "required": true,
          "description": "Stripe event ID"
        },
        "eventType": {
          "type": "string",
          "required": true,
          "description": "Event type (checkout.session.completed, etc.)"
        },
        "payloadSize": {
          "type": "number",
          "required": true,
          "description": "Payload size in bytes"
        },
        "signatureVerified": {
          "type": "boolean",
          "required": true,
          "description": "Whether signature was valid"
        },
        "processingStatus": {
          "type": "string",
          "required": true,
          "description": "Processing result",
          "values": ["success", "failed", "skipped_duplicate", "unhandled"]
        },
        "orderId": {
          "type": "string",
          "required": false,
          "description": "Associated order ID if applicable"
        },
        "errorMessage": {
          "type": "string",
          "required": false,
          "description": "Error message if failed"
        },
        "receivedAt": {
          "type": "timestamp",
          "required": true,
          "description": "When webhook was received"
        }
      }
    },

    "webhook_events": {
      "description": "Idempotency tracking for webhook processing",
      "documentId": "{stripeEventId}",
      "fields": {
        "eventId": {
          "type": "string",
          "required": true,
          "description": "Stripe event ID"
        },
        "eventType": {
          "type": "string",
          "required": true,
          "description": "Event type"
        },
        "receivedAt": {
          "type": "timestamp",
          "required": true,
          "description": "When event was received"
        },
        "processed": {
          "type": "boolean",
          "required": true,
          "description": "Whether event has been processed"
        },
        "processedAt": {
          "type": "timestamp",
          "required": false,
          "description": "When processing completed"
        },
        "processingStatus": {
          "type": "string",
          "required": false,
          "description": "Processing result"
        },
        "orderId": {
          "type": "string",
          "required": false,
          "description": "Associated order ID"
        },
        "errorMessage": {
          "type": "string",
          "required": false,
          "description": "Error if failed"
        },
        "livemode": {
          "type": "boolean",
          "required": true,
          "description": "Whether event is from live mode"
        }
      }
    }
  },

  "sharedSchemas": {
    "Address": {
      "description": "Address object used throughout the app",
      "fields": {
        "street": {
          "type": "string",
          "required": true,
          "description": "Street address"
        },
        "apartment": {
          "type": "string",
          "default": "",
          "description": "Unit, suite, or apartment number"
        },
        "city": {
          "type": "string",
          "required": true,
          "description": "City name"
        },
        "state": {
          "type": "string",
          "required": true,
          "description": "Province code (ON, BC, etc.)"
        },
        "postalCode": {
          "type": "string",
          "required": true,
          "description": "Canadian postal code"
        },
        "country": {
          "type": "string",
          "default": "Canada",
          "description": "Country name"
        },
        "phoneNumber": {
          "type": "string",
          "required": false,
          "description": "Contact phone number"
        },
        "isDefault": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the default address"
        },
        "label": {
          "type": "string",
          "required": false,
          "description": "Address label (Home, Work, etc.)"
        },
        "latitude": {
          "type": "number",
          "required": false,
          "description": "GPS latitude for shipping calculation"
        },
        "longitude": {
          "type": "number",
          "required": false,
          "description": "GPS longitude for shipping calculation"
        }
      }
    },

    "OrderItem": {
      "description": "Individual item within an order",
      "fields": {
        "productId": {
          "type": "string",
          "required": true,
          "description": "Reference to product"
        },
        "name": {
          "type": "string",
          "required": true,
          "description": "Product name at time of order"
        },
        "description": {
          "type": "string",
          "required": true,
          "description": "Product description"
        },
        "price": {
          "type": "number",
          "required": true,
          "description": "Price per unit at time of order"
        },
        "quantity": {
          "type": "number",
          "required": true,
          "description": "Quantity ordered"
        },
        "imageUrls": {
          "type": "array<string>",
          "required": true,
          "description": "Product images"
        },
        "sellerId": {
          "type": "string",
          "required": true,
          "description": "Seller's user ID"
        },
        "sellerAddress": {
          "type": "map",
          "required": true,
          "description": "Seller's address for shipping",
          "schema": "$ref:Address"
        },
        "deliveryStatus": {
          "type": "string",
          "default": "pending",
          "description": "Item delivery status",
          "values": ["pending", "shipped", "delivered"]
        },
        "trackingNumber": {
          "type": "string",
          "required": false,
          "description": "Shipping tracking number"
        },
        "confirmedByBuyer": {
          "type": "boolean",
          "default": false,
          "description": "Buyer confirmed receipt of this item"
        },
        "dateCreated": {
          "type": "timestamp",
          "required": true,
          "description": "When item was added to order"
        }
      }
    },

    "SellerPayout": {
      "description": "Payout breakdown for a single seller",
      "fields": {
        "sellerId": {
          "type": "string",
          "required": true,
          "description": "Seller's user ID"
        },
        "stripeAccountId": {
          "type": "string",
          "required": false,
          "description": "Seller's Stripe Connect account"
        },
        "gross": {
          "type": "number",
          "required": true,
          "description": "Total amount before platform fee"
        },
        "platformFee": {
          "type": "number",
          "required": true,
          "description": "Platform fee (2.5%)"
        },
        "net": {
          "type": "number",
          "required": true,
          "description": "Amount seller receives"
        },
        "paid": {
          "type": "boolean",
          "default": false,
          "description": "Whether payout has been sent"
        },
        "transferId": {
          "type": "string",
          "required": false,
          "description": "Stripe Transfer ID"
        },
        "paidAt": {
          "type": "timestamp",
          "required": false,
          "description": "When transfer was completed"
        },
        "error": {
          "type": "string",
          "required": false,
          "description": "Error message if transfer failed"
        }
      }
    }
  },

  "enums": {
    "OrderStatus": {
      "description": "Order lifecycle states",
      "values": {
        "pending": "Order created, awaiting payment",
        "confirmed": "Payment confirmed, order processing",
        "processing": "Being prepared for shipping",
        "shipped": "All items shipped",
        "delivered": "All items delivered",
        "cancelled": "Order cancelled",
        "failed": "Payment failed",
        "expired": "Checkout session expired",
        "refunded": "Full refund issued",
        "partially_refunded": "Partial refund issued"
      }
    },
    "PaymentStatus": {
      "description": "Payment lifecycle states",
      "values": {
        "awaiting_payment": "Waiting for customer payment",
        "processing": "Payment being processed",
        "paid": "Payment successful",
        "payment_failed": "Payment failed",
        "refunded": "Payment refunded",
        "session_expired": "Checkout session expired"
      }
    },
    "DeliveryStatus": {
      "description": "Per-item delivery states",
      "values": {
        "pending": "Awaiting shipment",
        "shipped": "Item shipped with tracking",
        "delivered": "Item delivered"
      }
    },
    "PayoutStatus": {
      "description": "Seller payout states",
      "values": {
        "pending": "Awaiting buyer confirmation",
        "processing": "Transfers being processed",
        "completed": "All sellers paid",
        "partial": "Some sellers paid",
        "failed": "Transfer(s) failed"
      }
    },
    "UserRoles": {
      "description": "User role types",
      "values": {
        "admin": "Platform administrator",
        "seller": "Registered seller",
        "assistant": "Customer support"
      }
    }
  },

  "categories": {
    "description": "Product category IDs and names",
    "list": [
      {"id": 1, "name": "Electronics"},
      {"id": 2, "name": "Computers"},
      {"id": 3, "name": "Gaming"},
      {"id": 4, "name": "Home & Kitchen"},
      {"id": 5, "name": "Fashion"},
      {"id": 6, "name": "Shoes & Accessories"},
      {"id": 7, "name": "Jewelry & Watches"},
      {"id": 8, "name": "Beauty & Personal Care"},
      {"id": 9, "name": "Health & Wellness"},
      {"id": 10, "name": "Sports & Fitness"},
      {"id": 11, "name": "Automotive"},
      {"id": 12, "name": "Tools & Hardware"},
      {"id": 13, "name": "Office Supplies"},
      {"id": 14, "name": "Books"},
      {"id": 15, "name": "Music & Instruments"},
      {"id": 16, "name": "Toys & Games"},
      {"id": 17, "name": "Baby & Kids"},
      {"id": 18, "name": "Pet Supplies"},
      {"id": 19, "name": "Groceries"},
      {"id": 20, "name": "Art & Collectibles"},
      {"id": 21, "name": "Digital Products"}
    ]
  },

  "businessRules": {
    "platformFee": {
      "percentage": 2.5,
      "description": "Platform fee charged on seller payouts"
    },
    "autoConfirmDays": {
      "days": 14,
      "description": "Days after delivery before auto-confirming order"
    },
    "currency": {
      "code": "cad",
      "symbol": "$",
      "description": "Canadian dollars only"
    },
    "shippingCalculation": {
      "formula": "distance_km * 0.5",
      "description": "Shipping cost based on distance from seller"
    },
    "taxes": {
      "description": "Provincial tax rates applied based on delivery address",
      "provinces": {
        "AB": {"GST": 5},
        "BC": {"GST": 5, "PST": 7},
        "MB": {"GST": 5, "PST": 7},
        "NB": {"HST": 15},
        "NL": {"HST": 15},
        "NS": {"HST": 15},
        "NT": {"GST": 5},
        "NU": {"GST": 5},
        "ON": {"HST": 13},
        "PE": {"HST": 15},
        "QC": {"GST": 5, "QST": 9.975},
        "SK": {"GST": 5, "PST": 6},
        "YT": {"GST": 5}
      }
    }
  }
}
