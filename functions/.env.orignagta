# Production environment — deployed to orignagta project.
# DO NOT set GOOGLE_APPLICATION_CREDENTIALS (use ADC from the service account).
# DO NOT set FUNCTIONS_EMULATOR (production is not an emulator).
GOOGLE_APPLICATION_CREDENTIALS=

# Stripe keys come from Firebase Secret Manager (SecretParam) — not set here.
