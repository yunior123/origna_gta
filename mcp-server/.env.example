# OrignaGTA MCP Server Configuration
# Copy to .env and fill in your values (do NOT commit .env)

# OrignaBase API URL
# Development:  https://api.dev.orignagta.ca
# Staging:      https://api.staging.orignagta.ca
# Production:   https://api.orignagta.ca
ORIGNABASE_URL=https://api.dev.orignagta.ca

# JWT Token for Authentication
# Get this by logging in to OrignaBase and copying the JWT from the response
# Example: REDACTED_SECRET
ORIGNABASE_JWT_TOKEN=your-jwt-token-here

# Environment (dev | staging | production)
NODE_ENV=development

# Server Configuration (optional)
MCP_SERVER_PORT=3000
DEBUG=false
