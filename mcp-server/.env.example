# OrignaGTA MCP Server Configuration

# API Configuration
ORIGNABASE_URL=https://api.dev.orignagta.ca

# Authentication — Choose one method:
#
# Option 1: Environment JWT (development only)
# ORIGNABASE_JWT_TOKEN=REDACTED_SECRET
#
# Option 2: OAuth Credentials
MCP_AUTH_METHOD=credentials
MCP_AUTH_EMAIL=agent@orignagta.ca
MCP_AUTH_PASSWORD=your_password_here
#
# Option 3: API Key
# MCP_AUTH_METHOD=api_key
# MCP_API_KEY=sk_test_...

# Spend Limits (in integer cents)
MCP_MAX_PURCHASE_CENTS=50000        # $500 max per checkout without confirmation
MCP_MAX_DAILY_CENTS=500000          # $5000 max per day

# Environment (optional)
NODE_ENV=development
LOG_LEVEL=info
EOF
