# OrignaGTA MCP Server Configuration

# OrignaBase Environment
ORIGNABASE_URL=https://api.dev.orignagta.ca

# Authentication (choose one: JWT or API Key)
# Option 1: JWT Token (recommended for user-specific queries)
ORIGNABASE_JWT_TOKEN=your-jwt-token-here

# Option 2: API Key (for service-to-service access)
# ORIGNABASE_API_KEY=your-api-key-here

# Server Configuration
MCP_SERVER_PORT=3000
NODE_ENV=development
