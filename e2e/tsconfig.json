{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@types/bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./lib/*"]
    }
  },
  "include": ["bun-test.d.ts", "lib/**/*.ts", "specs/**/*.ts", "ai/**/*.ts", "global-setup.ts"],
  "exclude": ["node_modules", "dist"]
}
