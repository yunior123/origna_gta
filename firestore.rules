rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================================================================
    // HELPER FUNCTIONS
    // ================================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStringWithLen(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isValidEmail(email) {
      return isStringWithLen(email, 6, 254) &&
        email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidName(name) {
      // Allow letters, apostrophes, periods, hyphens, spaces (e.g., O'Brien, Jr., Mary-Jane)
      return isStringWithLen(name, 2, 60) &&
        name.matches("^[a-zA-ZÀ-ÿ][a-zA-ZÀ-ÿ'. \\-]*[a-zA-ZÀ-ÿ.']?$");
    }

    function isValidPostalCode(code) {
      return isStringWithLen(code, 6, 7) &&
        code.matches('^[A-Za-z]\\d[A-Za-z][ -]?\\d[A-Za-z]\\d$');
    }

    function isValidProvince(code) {
      return code in ['AB','BC','MB','NB','NL','NS','NT','NU','ON','PE','QC','SK','YT'];
    }

    function isValidAddress(addr) {
      return addr is map &&
        addr.keys().hasOnly(['street','apartment','city','state','postalCode','country','phoneNumber','isDefault','label','latitude','longitude']) &&
        isStringWithLen(addr.street, 3, 100) &&
        (addr.apartment == null || isStringWithLen(addr.apartment, 1, 20)) &&
        isStringWithLen(addr.city, 2, 50) &&
        isValidProvince(addr.state) &&
        isValidPostalCode(addr.postalCode) &&
        // Buyer/shipping addresses must be in Canada
        (addr.country == 'Canada' || addr.country == 'CA' || addr.country == 'canada') &&
        (addr.phoneNumber == null || (addr.phoneNumber is string && addr.phoneNumber.matches('^\\d{10,15}$'))) &&
        (addr.isDefault == null || addr.isDefault is bool) &&
        (addr.label == null || isStringWithLen(addr.label, 1, 30)) &&
        (addr.latitude == null || (addr.latitude is number && addr.latitude >= -90 && addr.latitude <= 90)) &&
        (addr.longitude == null || (addr.longitude is number && addr.longitude >= -180 && addr.longitude <= 180));
    }

    // Seller addresses can be from any country — no Canada-only restriction
    function isValidSellerAddress(addr) {
      return addr is map &&
        addr.keys().hasOnly(['street','apartment','city','state','postalCode','country','phoneNumber','isDefault','label','latitude','longitude']) &&
        isStringWithLen(addr.street, 3, 100) &&
        (addr.apartment == null || isStringWithLen(addr.apartment, 1, 20)) &&
        isStringWithLen(addr.city, 2, 50) &&
        isStringWithLen(addr.state, 1, 50) &&
        isStringWithLen(addr.postalCode, 2, 15) &&
        isStringWithLen(addr.country, 2, 56) &&
        (addr.phoneNumber == null || (addr.phoneNumber is string && addr.phoneNumber.matches('^\\d{10,15}$'))) &&
        (addr.isDefault == null || addr.isDefault is bool) &&
        (addr.label == null || isStringWithLen(addr.label, 1, 30)) &&
        (addr.latitude == null || (addr.latitude is number && addr.latitude >= -90 && addr.latitude <= 90)) &&
        (addr.longitude == null || (addr.longitude is number && addr.longitude >= -180 && addr.longitude <= 180));
    }

    // Digital products do not require a shippable seller address, but shape must remain strict.
    function isValidDigitalSellerAddress(addr) {
      return addr is map &&
        addr.keys().hasOnly(['street','apartment','city','state','postalCode','country','phoneNumber','isDefault','label','latitude','longitude']) &&
        (addr.street is string && addr.street.size() <= 100) &&
        (addr.apartment == null || (addr.apartment is string && addr.apartment.size() <= 20)) &&
        (addr.city is string && addr.city.size() <= 50) &&
        (addr.state is string && addr.state.size() <= 50) &&
        (addr.postalCode is string && addr.postalCode.size() <= 15) &&
        (addr.country is string && addr.country.size() <= 56) &&
        (addr.phoneNumber == null || (addr.phoneNumber is string && addr.phoneNumber.matches('^\\d{10,15}$'))) &&
        (addr.isDefault == null || addr.isDefault is bool) &&
        (addr.label == null || isStringWithLen(addr.label, 1, 30)) &&
        (addr.latitude == null || (addr.latitude is number && addr.latitude >= -90 && addr.latitude <= 90)) &&
        (addr.longitude == null || (addr.longitude is number && addr.longitude >= -180 && addr.longitude <= 180));
    }
    
    function hasRole(role) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.roles.hasAny([role]);
    }
    
    function isAdmin() {
      return hasRole('admin');
    }

    function hasActivePremium(userId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/subscriptions/$(userId)) &&
        get(/databases/$(database)/documents/subscriptions/$(userId)).data.status in ['active', 'trialing'];
    }

    function sellerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSellerApproved() {
      return isAuthenticated() && (
        sellerProfile().roles.hasAny(['admin']) || (
          sellerProfile().roles.hasAny(['seller']) &&
          sellerProfile().onboardingCompleted == true &&
          sellerProfile().chargesEnabled == true &&
          sellerProfile().payoutsEnabled == true
        )
      ) && sellerProfile().suspended != true;
    }

    function isProductOwner() {
      return isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }
    
    // ================================================================
    // ORDER STATE MACHINE VALIDATION - CRITICAL BUSINESS LOGIC
    // ================================================================
    function isValidOrderStateTransition(currentStatus, newStatus) {
      // Define valid state transitions
      // This prevents data corruption from invalid status changes
      let validTransitions = {
        'pending': ['confirmed', 'cancelled', 'failed', 'expired'], // Initial state -> completed states
        'confirmed': ['processing', 'cancelled', 'expired'],       // After payment confirmed
        'processing': ['shipped', 'cancelled'],                    // Seller processing
        'shipped': ['in_transit', 'delivered'],                     // Shipped / in transit (cancel not allowed after ship)
        'in_transit': ['delivered', 'cancelled'],                  // Carrier in transit
        'delivered': ['refunded', 'partially_refunded', 'disputed'], // After delivery
        'cancelled': [],                                            // Terminal state - no transitions
        'failed': ['pending'],                                      // Retry -> pending
        'expired': ['pending'],                                     // Retry -> pending
        'refunded': [],                                             // Terminal state
        'partially_refunded': ['refunded'],                         // Can become fully refunded
        'disputed': ['refunded'],                                   // After dispute resolution
      };
      
      // Get valid next states for current status
      let allowedNextStates = validTransitions.get(currentStatus, []);
      return newStatus in allowedNextStates;
    }
    
    // ================================================================
    // USERS COLLECTION
    // ================================================================
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read any profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own profile (limited fields only)
      // Admins can update any user profile fields
      // SECURITY: Email is immutable for non-admin users (must match existing value)
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.roles == resource.data.roles &&
        request.resource.data.email == resource.data.email &&
        isValidName(request.resource.data.name) &&
        (request.resource.data.address == null || isValidAddress(request.resource.data.address)) &&
        // Prevent users from modifying seller-specific fields (safe access for buyer accounts that lack these fields)
        (!resource.data.keys().hasAny(['commissionRate']) || request.resource.data.commissionRate == resource.data.commissionRate) &&
        (!resource.data.keys().hasAny(['verified']) || request.resource.data.verified == resource.data.verified) &&
        (!resource.data.keys().hasAny(['verificationStatus']) || request.resource.data.verificationStatus == resource.data.verificationStatus) &&
        (!resource.data.keys().hasAny(['payoutHoldDays']) || request.resource.data.payoutHoldDays == resource.data.payoutHoldDays) &&
        (!resource.data.keys().hasAny(['suspended']) || request.resource.data.suspended == resource.data.suspended) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'address',
          'lastCheckoutSession',
          'lastOrderId',
          'lastCheckoutTimestamp',
          'notifyNewProducts',
          'notifyTrending'
        ]));
      
      // Users can create their own profile with strict fields only
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.roles.size() == 1 &&
        request.resource.data.roles[0] == 'buyer' &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'roles', 'address', 'createdAt',
          'emailConsent', 'consentTimestamp', 'consentMethod',
          'privacyAcceptedAt', 'termsAcceptedAt',
          'dataProcessingConsent', 'marketingOptIn',
          'privacyPolicyVersion', 'termsVersion',
          'preferredLanguage', 'platform'
        ]);
      
      // Users can't delete their own account (use Cloud Function)
      allow delete: if false;
      
      // --- CART SUBCOLLECTION ---
      match /cart/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['productId','quantity','createdAt']) &&
          request.resource.data.productId is string &&
          request.resource.data.quantity is int &&
          request.resource.data.quantity > 0 && request.resource.data.quantity <= 100 &&
          request.resource.data.createdAt is timestamp;
        allow delete: if isOwner(userId);
      }
      
      // --- FAVORITES SUBCOLLECTION ---
      match /favorites/{productId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['productId','dateFavorited']) &&
          request.resource.data.productId is string &&
          request.resource.data.dateFavorited is timestamp;
        allow delete: if isOwner(userId);
      }
      
      // --- ADDRESSES SUBCOLLECTION ---
      match /addresses/{addressId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAddress(request.resource.data);
        allow delete: if isOwner(userId);
      }
      
      // --- PAYOUTS SUBCOLLECTION (Seller payout history) ---
      match /payouts/{payoutId} {
        // Sellers can read their own payout history
        allow read: if isOwner(userId) || isAdmin();
        
        // Only backend can create/update payouts
        allow create, update: if false;
        
        // No deletes (audit trail)
        allow delete: if false;
            // --- WAREHOUSES SUBCOLLECTION (Seller shipping locations) ---
      match /warehouses/{warehouseId} {
        // Only the seller (owner) can read/write their warehouses
        // Buyers never read warehouse docs directly — only denormalized fields on products are public
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          get(/databases/$(database)/documents/users/$(userId)).data.roles.hasAny(['seller']) &&
          request.resource.data.keys().hasOnly([
            'label', 'type', 'address', 'isDefault', 'createdAt'
          ]) &&
          request.resource.data.label is string &&
          request.resource.data.label.size() >= 1 &&
          request.resource.data.label.size() <= 100 &&
          request.resource.data.type in ['warehouse', 'personal'] &&
          request.resource.data.address is map &&
          request.resource.data.isDefault is bool;
        allow update: if isOwner(userId) &&
          get(/databases/$(database)/documents/users/$(userId)).data.roles.hasAny(['seller']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'label', 'type', 'address', 'isDefault'
          ]) &&
          request.resource.data.label is string &&
          request.resource.data.label.size() >= 1 &&
          request.resource.data.type in ['warehouse', 'personal'];
        allow delete: if isAdmin();  // Sellers use delete_warehouse callable (enforces stock check)
      }
    }
    
    // ================================================================
    // PRODUCTS COLLECTION
    // ================================================================
    match /products/{productId} {
      // Anyone can read active products; owners/admins can read all
      allow read: if resource.data.isActive != false || isAdmin() || isProductOwner();

      // Only sellers can create products
      // Must set correct sellerId
      // Seller addresses can be from any country (buyers/shipping must be Canada)
      // CAD-ONLY: All prices are in Canadian Dollars
      allow create: if isAdmin() || (isSellerApproved() &&
        request.resource.data.sellerId == request.auth.uid &&
        // CRITICAL: Prevent client injecting arbitrary fields (e.g., rating)
        request.resource.data.keys().hasOnly([
          // Core
          'name', 'price', 'compareAtPrice', 'description', 'imageUrls',
          'sellerId', 'sellerAddress',
          'categoryId', 'stockQuantity',
          'keywords',
          // Metadata
          'createdAt', 'isActive', 'rating', 'status', 'taxCode',
          // Shipping / delivery
          'weightKg', 'lengthCm', 'widthCm', 'heightCm',
          'isLocalDeliveryOnly', 'isPerishable', 'estimatedShipDays',
          'deliveryOptions', 'minimumOrderQuantity', 'freeShipping',
          'isDigital',
          // Digital product fields
          'digitalType', 'slug', 'digitalBuilds', 'bookSourceUrl', 'deviceLimit',
          // Supplier / inventory (structured)
          'supplier', 'inventory',
          // Legacy supplier fields (backward compatibility)
          'cost', 'supplierSku', 'supplierUrl',
          // Multi-warehouse fields
          'sellerSku', 'warehouseIds', 'warehouseStock', 'shipFromCity', 'shipFromProvince',
          // Trending (Admin only normally, but allowed here if they bypass)
          'isTrending', 'trendingAt'
        ]) &&
        isStringWithLen(request.resource.data.name, 2, 120) &&
        isStringWithLen(request.resource.data.description, 10, 4000) &&
        (!request.resource.data.keys().hasAny(['sellerAddress']) || isValidSellerAddress(request.resource.data.sellerAddress)) &&
        request.resource.data.isActive == true &&
        request.resource.data.price > 0);
      allow update: if isAuthenticated() &&
        ((resource.data.sellerId == request.auth.uid && isSellerApproved()) || isAdmin()) &&
          // Only allow specific fields to be changed via client updates
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'price', 'compareAtPrice', 'description', 'imageUrls',
            'sellerAddress', 'keywords',
            'stockQuantity',
            'weightKg', 'lengthCm', 'widthCm', 'heightCm',
            'isLocalDeliveryOnly', 'isPerishable', 'estimatedShipDays',
            'deliveryOptions', 'minimumOrderQuantity', 'freeShipping',
            'isDigital', 'taxCode',
            // Digital product fields
            'digitalType', 'slug', 'digitalBuilds', 'bookSourceUrl', 'deviceLimit',
            'supplier', 'inventory', 'status',
            'cost', 'supplierSku', 'supplierUrl',
            // Multi-warehouse fields
            'sellerSku', 'warehouseIds', 'warehouseStock', 'shipFromCity', 'shipFromProvince',
            // Admin-only toggles
            'isActive', 'isTrending', 'trendingAt'
          ]) &&
          // Never allow ratings from client updates
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'ratingCount']) &&
          (isAdmin() || request.resource.data.sellerId == resource.data.sellerId) &&
          isStringWithLen(request.resource.data.name, 2, 120) &&
          isStringWithLen(request.resource.data.description, 10, 4000) &&
          // sellerAddress is optional when warehouseIds is provided
          (!request.resource.data.keys().hasAny(['sellerAddress']) ||
           (request.resource.data.isDigital == true &&
            isValidDigitalSellerAddress(request.resource.data.sellerAddress)) ||
           isValidSellerAddress(request.resource.data.sellerAddress)) &&
          request.resource.data.imageUrls is list &&
          request.resource.data.imageUrls.size() >= 1 && request.resource.data.imageUrls.size() <= 5 &&
          request.resource.data.keywords is list &&
          request.resource.data.keywords.size() <= 30 &&
          request.resource.data.stockQuantity >= 0 &&
          // Validate categoryId is a valid integer (1-21)
          request.resource.data.categoryId is int &&
          request.resource.data.categoryId >= 1 &&
          request.resource.data.categoryId <= 21 &&
          // Validate product status if changed
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
           request.resource.data.status in ['draft', 'active', 'paused', 'archived', 'out_of_stock']) &&
          // FIX: Enforce positive price on update (prevents negative price attack)
          request.resource.data.price > 0 &&
          request.resource.data.price <= 100000 &&
          // Sellers cannot toggle isActive; admins can.
          (isAdmin() || request.resource.data.isActive == resource.data.isActive) &&
          !request.resource.data.keys().hasAny(['deletedAt']);

      // Only product owner or admin can delete
      allow delete: if isAuthenticated() &&
        (isAdmin() || (resource.data.sellerId == request.auth.uid && isSellerApproved()));

      // Inventory levels subcollection — backend-only writes (checkout, triggers, cancel)
      match /inventoryLevels/{warehouseId} {
        allow read: if true;
        allow write: if false;  // Backend-only via Admin SDK
      }
    }
    
    // ================================================================
    // ORDERS COLLECTION
    // ================================================================
    match /orders/{orderId} {
      // Users can read their own orders
      // Sellers can read orders containing their products
      // Admins can read all orders
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.sellerIds.hasAny([request.auth.uid]) ||
        isAdmin()
      );
      
      // ONLY BACKEND CAN CREATE ORDERS
      // This prevents client-side order manipulation
      allow create: if false;
      
      // Backend/admin only with state machine validation and field whitelisting
      // Phase 3.5 fields: sellerCaptures, captureAttempts, requiresManualReview, fraudScore
      allow update: if isAdmin() &&
        // CRITICAL: Validate order status transitions using the CORRECT field name
        isValidOrderStateTransition(resource.data.orderStatus, request.resource.data.orderStatus) &&
        // CRITICAL: Whitelist updatable fields — prevent overwriting financial data, userId, paymentIntentId
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderStatus', 'paymentStatus', 'deliveryStatus',
          'adminNote', 'updatedAt', 'cancelledAt', 'cancelledBy',
          'cancellationReason', 'confirmedAt', 'shippedAt',
          'trackingNumber', 'carrier', 'stockRestored',
          // Phase 3.5 fields
          'sellerCaptures', 'captureAttempts', 'requiresManualReview', 'fraudScore'
        ]) &&
        // Phase 3.5: Validate new fields if present
        (!request.resource.data.keys().hasAny(['sellerCaptures']) || request.resource.data.sellerCaptures is map) &&
        (!request.resource.data.keys().hasAny(['captureAttempts']) || request.resource.data.captureAttempts is int) &&
        (!request.resource.data.keys().hasAny(['requiresManualReview']) || request.resource.data.requiresManualReview is bool) &&
        (!request.resource.data.keys().hasAny(['fraudScore']) || (request.resource.data.fraudScore is int && request.resource.data.fraudScore >= 0 && request.resource.data.fraudScore <= 100)) &&
        // CRITICAL: Immutable fields — admin cannot change financial data or ownership
        // Field names MUST match what backend writes (cents-based fields)
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.totalAmountCents == resource.data.totalAmountCents &&
        request.resource.data.subtotalCents == resource.data.subtotalCents &&
        request.resource.data.items == resource.data.items;
      
      // No one can delete orders (only backend)
      allow delete: if false;
    }
    
    // ================================================================
    // SECURITY_ALERTS COLLECTION (Phase 3.5)
    // ================================================================
    match /security_alerts/{alertId} {
      // Only admins can read security alerts
      allow read: if isAdmin();
      
      // Only backend can create alerts
      allow create: if false;
      
      // No updates or deletes (immutable audit log)
      allow update, delete: if false;
    }
    
    // ================================================================
    // SELLER_METRICS COLLECTION (TASKS 11)
    // ================================================================
    match /seller_metrics/{sellerMetricsId} {
      // Sellers can read their own metrics, Admins can read all
      allow read: if isAdmin() || isOwner(sellerMetricsId);
      
      // Backend only
      allow create, update, delete: if false;
    }

    // ================================================================
    // STOCK_NOTIFICATIONS COLLECTION (TASKS 07)
    // ================================================================
    match /stock_notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Backend only handles creates via specific `subscribe_stock_notification` endpoint to ensure consistency
      allow create, update: if false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ================================================================
    // PRODUCT_QUESTIONS COLLECTION (TASKS 09)
    // ================================================================
    match /product_questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.askerId == request.auth.uid
        && hasActivePremium(request.auth.uid)
        && request.resource.data.question.size() >= 10
        && request.resource.data.question.size() <= 500;
      allow update: if false;  // answers written by backend only
      allow delete: if false;  // no deletes from client
    }
    
    // ================================================================
    // ADMIN_LOGS COLLECTION
    // ================================================================
    match /admin_logs/{logId} {
      // Only admins can read admin logs
      allow read: if isAdmin();
      
      // Only backend can create logs
      allow create: if false;
      
      // No updates or deletes (immutable audit log)
      allow update, delete: if false;
    }
    
    // ================================================================
    // CONFIG COLLECTION (Platform Settings)
    // ================================================================
    match /config/{configId} {
      // Admins can read all config
      allow read: if isAdmin();
      
      // Authenticated users can read provider status (for payment UI)
      allow read: if isAuthenticated() && configId == 'payment_providers';
      
      // Only backend can write config
      allow write: if false;
    }
    
    // ================================================================
    // BACKEND-ONLY COLLECTIONS (explicit deny for defense-in-depth)
    // ================================================================
    match /product_ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create, delete: if false;
      // N-03: Seller may update ONLY sellerReply + sellerReplyAt on their own product's rating
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerReply', 'sellerReplyAt']) &&
        get(/databases/$(database)/documents/products/$(resource.data.productId)).data.sellerId == request.auth.uid;
      // N-04: helpfulCount and helpfulVoterIds are backend-only (handled via Cloud Function)
    }
    
    match /refunds/{refundId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    
    match /webhook_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    
    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Backend-only collections: payouts top-level & Algolia sync failures
    match /payouts/{payoutId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /algolia_sync_failures/{failureId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ================================================================
    // LICENSES COLLECTION
    // Buyers read their own licenses. Backend-only write.
    // ================================================================
    match /licenses/{licenseKey} {
      // Buyer reads their own license
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Admin reads all
      allow read: if isAdmin();
      // Backend-only writes (Cloud Functions only)
      allow create, update, delete: if false;
    }

    // ================================================================
    // SUBSCRIPTIONS COLLECTION
    // subscriptions/{userId} — premium subscription records.
    // Backend writes on Stripe webhook. User reads own. No client writes.
    // ================================================================
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false; // Backend-only writes
    }

    // ================================================================
    // CHATS COLLECTION
    // chats/{chatId} — product-scoped buyer↔seller chat threads.
    // Only premium buyers and the seller of the product can participate.
    // Backend creates threads. Participants read/write messages.
    // ================================================================
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      // Chat threads created via backend only
      allow create, update, delete: if false;

      match /messages/{messageId} {
        // Buyer (premium) and seller can read messages in their thread
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
        // Only participants can send messages; buyers must be premium to send
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPremium == true)
        ) && request.resource.data.keys().hasOnly(['senderId','text','createdAt','read']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.read == false;
        allow update, delete: if false;
      }
    }

    // ================================================================
    // BOOK_ACCESS_TOKENS COLLECTION
    // Single-use redirect tokens — backend creates, no client read.
    // ================================================================
    match /book_access_tokens/{token} {
      // No client reads — token is consumed server-side via redirect
      allow read, write: if false;
    }

    // ================================================================
    // MAIL LOGS COLLECTION (For E2E Testing)
    // ================================================================
    match /_mail_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ================================================================
    // COUPONS COLLECTION (N-07)
    // Any authenticated user can read (to validate a code).
    // All writes are backend-only via Cloud Functions.
    // ================================================================
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ================================================================
    // USER_SECURITY — Backend-only MFA secrets (TOTP, backup codes)
    // NEVER readable by any client — Admin SDK only.
    // ================================================================
    match /user_security/{userId} {
      allow read, write: if false;
    }

    // ================================================================
    // SELLER_PROFILES — Seller-specific data split from users doc.
    // Owner and admins can read/write. Buyers never need this.
    // ================================================================
    match /seller_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ================================================================
    // CATCH-ALL: Deny access to any unmatched collections
    // This prevents accidental data exposure if new collections are
    // added without explicit rules. Defense-in-depth.
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
    
    // ================================================================
    // VALIDATION FUNCTIONS
    // ================================================================
  }
}
}
