rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================================================================
    // HELPER FUNCTIONS
    // ================================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStringWithLen(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isValidEmail(email) {
      return isStringWithLen(email, 6, 254) &&
        email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidName(name) {
      // Allow letters, apostrophes, periods, hyphens, spaces (e.g., O'Brien, Jr., Mary-Jane)
      return isStringWithLen(name, 2, 60) &&
        name.matches("^[a-zA-ZÀ-ÿ][a-zA-ZÀ-ÿ'. \\-]*[a-zA-ZÀ-ÿ.']?$");
    }

    function isValidPostalCode(code) {
      return isStringWithLen(code, 6, 7) &&
        code.matches('^[A-Za-z]\\d[A-Za-z][ -]?\\d[A-Za-z]\\d$');
    }

    function isValidProvince(code) {
      return code in ['AB','BC','MB','NB','NL','NS','NT','NU','ON','PE','QC','SK','YT'];
    }

    function isValidAddress(addr) {
      return addr is map &&
        addr.keys().hasOnly(['street','apartment','city','state','postalCode','country','phoneNumber','isDefault','label','latitude','longitude']) &&
        isStringWithLen(addr.street, 3, 100) &&
        (addr.apartment == null || isStringWithLen(addr.apartment, 1, 20)) &&
        isStringWithLen(addr.city, 2, 50) &&
        isValidProvince(addr.state) &&
        isValidPostalCode(addr.postalCode) &&
        // CANADA-ONLY: Seller/Buyer addresses must be in Canada
        (addr.country == 'Canada' || addr.country == 'CA' || addr.country == 'canada') &&
        (addr.phoneNumber == null || (addr.phoneNumber is string && addr.phoneNumber.matches('^\\d{10,15}$'))) &&
        (addr.isDefault == null || addr.isDefault is bool) &&
        (addr.label == null || isStringWithLen(addr.label, 1, 30)) &&
        (addr.latitude == null || (addr.latitude is number && addr.latitude >= -90 && addr.latitude <= 90)) &&
        (addr.longitude == null || (addr.longitude is number && addr.longitude >= -180 && addr.longitude <= 180));
    }
    
    function hasRole(role) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.roles.hasAny([role]);
    }
    
    function isAdmin() {
      return hasRole('admin');
    }

    function sellerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSellerApproved() {
      return isAuthenticated() && (
        sellerProfile().roles.hasAny(['admin']) || (
          sellerProfile().roles.hasAny(['seller']) &&
          sellerProfile().onboardingCompleted == true &&
          sellerProfile().chargesEnabled == true &&
          sellerProfile().payoutsEnabled == true
        )
      ) && sellerProfile().suspended != true;
    }

    function isProductOwner() {
      return isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }
    
    // ================================================================
    // ORDER STATE MACHINE VALIDATION - CRITICAL BUSINESS LOGIC
    // ================================================================
    function isValidOrderStateTransition(currentStatus, newStatus) {
      // Define valid state transitions
      // This prevents data corruption from invalid status changes
      let validTransitions = {
        'pending': ['confirmed', 'cancelled', 'failed'],           // Initial state -> completed states
        'confirmed': ['processing', 'cancelled'],                  // After payment confirmed
        'processing': ['shipped', 'cancelled'],                    // Seller processing
        'shipped': ['delivered', 'cancelled'],                     // In transit
        'delivered': ['refunded', 'partially_refunded'],           // After delivery
        'cancelled': [],                                            // Terminal state - no transitions
        'failed': ['pending'],                                      // Retry -> pending
        'expired': ['pending'],                                     // Retry -> pending
        'refunded': [],                                             // Terminal state
        'partially_refunded': ['refunded'],                         // Can become fully refunded
      };
      
      // Get valid next states for current status
      let allowedNextStates = validTransitions.get(currentStatus, []);
      return newStatus in allowedNextStates;
    }
    
    // ================================================================
    // USERS COLLECTION
    // ================================================================
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read any profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own profile (limited fields only)
      // Admins can update any user profile fields
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.roles == resource.data.roles &&
        isValidName(request.resource.data.name) &&
        isValidEmail(request.resource.data.email) &&
        (request.resource.data.address == null || isValidAddress(request.resource.data.address)) &&
        // Prevent users from modifying seller-specific fields
        request.resource.data.commissionRate == resource.data.commissionRate &&
        request.resource.data.verified == resource.data.verified &&
        request.resource.data.verificationStatus == resource.data.verificationStatus &&
        request.resource.data.payoutHoldDays == resource.data.payoutHoldDays &&
        request.resource.data.suspended == resource.data.suspended &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'address',
          'lastCheckoutSession',
          'lastOrderId',
          'lastCheckoutTimestamp'
        ]));
      
      // Users can create their own profile with strict fields only
      // TEMPORARILY SIMPLIFIED FOR TESTING
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.roles.size() == 1 &&
        request.resource.data.roles[0] == 'buyer';
      
      // Users can't delete their own account (use Cloud Function)
      allow delete: if false;
      
      // --- CART SUBCOLLECTION ---
      match /cart/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['productId','quantity','dateCreated']) &&
          request.resource.data.productId is string &&
          request.resource.data.quantity is int &&
          request.resource.data.quantity > 0 && request.resource.data.quantity <= 100 &&
          request.resource.data.dateCreated is timestamp;
        allow delete: if isOwner(userId);
      }
      
      // --- FAVORITES SUBCOLLECTION ---
      match /favorites/{productId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['productId','dateFavorited']) &&
          request.resource.data.productId is string &&
          request.resource.data.dateFavorited is timestamp;
        allow delete: if isOwner(userId);
      }
      
      // --- PAYOUTS SUBCOLLECTION (Seller payout history) ---
      match /payouts/{payoutId} {
        // Sellers can read their own payout history
        allow read: if isOwner(userId) || isAdmin();
        
        // Only backend can create/update payouts
        allow create, update: if false;
        
        // No deletes (audit trail)
        allow delete: if false;
      }
    }
    
    // ================================================================
    // PRODUCTS COLLECTION
    // ================================================================
    match /products/{productId} {
      // Anyone can read active products; owners/admins can read all
      allow read: if resource.data.isActive != false || isAdmin() || isProductOwner();

      // Only sellers can create products
      // Must set correct sellerId
      // CANADA-ONLY: Products must have Canadian seller address
      // CAD-ONLY: All prices are in Canadian Dollars
      allow create: if isSellerApproved() &&
        request.resource.data.sellerId == request.auth.uid &&
        // CRITICAL: Prevent client injecting arbitrary fields (e.g., rating)
        request.resource.data.keys().hasOnly([
          // Core
          'name', 'price', 'description', 'imageUrls',
          'sellerId', 'sellerAddress',
          'categoryId', 'stockQuantity',
          'keywords',
          // Metadata
          'dateCreated', 'isActive', 'rating', 'status', 'taxCode',
          // Shipping / delivery
          'weightKg', 'lengthCm', 'widthCm', 'heightCm',
          'isLocalDeliveryOnly', 'isPerishable', 'estimatedShipDays',
          'deliveryOptions', 'minimumOrderQuantity', 'freeShipping',
          'isDigital',
          // Supplier / inventory (structured)
          'supplier', 'inventory',
          // Legacy supplier fields (backward compatibility)
          'cost', 'supplierSku', 'supplierUrl'
        ]) &&
        isStringWithLen(request.resource.data.name, 2, 120) &&
        isStringWithLen(request.resource.data.description, 10, 4000) &&
        isValidAddress(request.resource.data.sellerAddress) &&
        // Enforce Canada-only seller address
        (request.resource.data.sellerAddress.country == 'Canada' || 
         request.resource.data.sellerAddress.country == 'CA' ||
         request.resource.data.sellerAddress.country == 'canada') &&
        request.resource.data.dateCreated is timestamp &&
        request.resource.data.imageUrls is list &&
        // Allow empty images initially to support Create -> Upload -> Update flow
        // request.resource.data.imageUrls.size() >= 1 && request.resource.data.imageUrls.size() <= 5 &&
        request.resource.data.keywords is list &&
        request.resource.data.keywords.size() <= 30 &&
        // Client may include rating, but must start at 0
        (!request.resource.data.keys().hasAny(['rating']) || request.resource.data.rating == 0) &&
        request.resource.data.isActive == true &&
        request.resource.data.stockQuantity >= 0 &&
        // CAD-ONLY: Price must be positive (all prices in CAD)
        request.resource.data.price > 0 &&
        request.resource.data.price <= 100000;

      // Product updates - owner/admin only (ratings updated via backend)
      allow update: if isAuthenticated() &&
        ((resource.data.sellerId == request.auth.uid && isSellerApproved()) || isAdmin()) &&
          // Only allow specific fields to be changed via client updates
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'price', 'description', 'imageUrls',
            'sellerAddress', 'keywords',
            'stockQuantity',
            'weightKg', 'lengthCm', 'widthCm', 'heightCm',
            'isLocalDeliveryOnly', 'isPerishable', 'estimatedShipDays',
            'deliveryOptions', 'minimumOrderQuantity', 'freeShipping',
            'isDigital', 'taxCode',
            'supplier', 'inventory', 'status',
            'cost', 'supplierSku', 'supplierUrl',
            // Admin-only toggles
            'isActive'
          ]) &&
          // Never allow ratings from client updates
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'ratingCount']) &&
          request.resource.data.sellerId == resource.data.sellerId &&
          isStringWithLen(request.resource.data.name, 2, 120) &&
          isStringWithLen(request.resource.data.description, 10, 4000) &&
          isValidAddress(request.resource.data.sellerAddress) &&
          request.resource.data.imageUrls is list &&
          request.resource.data.imageUrls.size() >= 1 && request.resource.data.imageUrls.size() <= 5 &&
          request.resource.data.keywords is list &&
          request.resource.data.keywords.size() <= 30 &&
          request.resource.data.stockQuantity >= 0 &&
          // Sellers cannot toggle isActive; admins can.
          (isAdmin() || request.resource.data.isActive == resource.data.isActive) &&
          !request.resource.data.keys().hasAny(['deletedAt']);

      // Only product owner or admin can delete
      allow delete: if isAuthenticated() &&
        (isAdmin() || (resource.data.sellerId == request.auth.uid && isSellerApproved()));
    }
    
    // ================================================================
    // ORDERS COLLECTION
    // ================================================================
    match /orders/{orderId} {
      // Users can read their own orders
      // Sellers can read orders containing their products
      // Admins can read all orders
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.sellerIds.hasAny([request.auth.uid]) ||
        isAdmin()
      );
      
      // ONLY BACKEND CAN CREATE ORDERS
      // This prevents client-side order manipulation
      allow create: if false;
      
      // Backend/admin only with state machine validation
      // Phase 3.5 fields: sellerCaptures, captureAttempts, requiresManualReview, fraudScore
      allow update: if isAdmin() &&
        // CRITICAL: Validate order status transitions
        isValidOrderStateTransition(resource.data.status, request.resource.data.status) &&
        // Phase 3.5: Validate new fields if present
        (!request.resource.data.keys().hasAny(['sellerCaptures']) || request.resource.data.sellerCaptures is map) &&
        (!request.resource.data.keys().hasAny(['captureAttempts']) || request.resource.data.captureAttempts is int) &&
        (!request.resource.data.keys().hasAny(['requiresManualReview']) || request.resource.data.requiresManualReview is bool) &&
        (!request.resource.data.keys().hasAny(['fraudScore']) || (request.resource.data.fraudScore is int && request.resource.data.fraudScore >= 0 && request.resource.data.fraudScore <= 100));
      
      // No one can delete orders (only backend)
      allow delete: if false;
    }
    
    // ================================================================
    // SECURITY_ALERTS COLLECTION (Phase 3.5)
    // ================================================================
    match /security_alerts/{alertId} {
      // Only admins can read security alerts
      allow read: if isAdmin();
      
      // Only backend can create alerts
      allow create: if false;
      
      // No updates or deletes (immutable audit log)
      allow update, delete: if false;
    }
    
    // ================================================================
    // ADMIN_LOGS COLLECTION
    // ================================================================
    match /admin_logs/{logId} {
      // Only admins can read admin logs
      allow read: if isAdmin();
      
      // Only backend can create logs
      allow create: if false;
      
      // No updates or deletes (immutable audit log)
      allow update, delete: if false;
    }
    
    // ================================================================
    // CONFIG COLLECTION (Platform Settings)
    // ================================================================
    match /config/{configId} {
      // Admins can read all config
      allow read: if isAdmin();
      
      // Authenticated users can read provider status (for payment UI)
      allow read: if isAuthenticated() && configId == 'payment_providers';
      
      // Only backend can write config
      allow write: if false;
    }
    
    // ================================================================
    // VALIDATION FUNCTIONS
    // ================================================================
  }
}
