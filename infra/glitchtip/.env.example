SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
POSTGRES_PASSWORD=replace-with-strong-postgres-password

GLITCHTIP_DOMAIN=https://glitchtip.orignagta.ca
ALLOWED_HOSTS=glitchtip.orignagta.ca
CSRF_TRUSTED_ORIGINS=https://glitchtip.orignagta.ca

DATABASE_URL=REDACTED_SECRET/glitchtip
VALKEY_URL=redis://valkey:6379/0

EMAIL_URL=smtp://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=alerts@orignagta.ca

ENABLE_USER_REGISTRATION=false
ENABLE_ORGANIZATION_CREATION=false
GLITCHTIP_EMBED_WORKER=true
GLITCHTIP_ENABLE_UPTIME=false
GLITCHTIP_ENABLE_LOGS=false
GLITCHTIP_RETENTION_DAYS=90
SECURE_HSTS_SECONDS=31536000
