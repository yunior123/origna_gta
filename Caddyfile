{
 email admin@orignagta.ca

 # Trust Cloudflare proxy headers for real client IP
 # When CF proxy is enabled, requests come from CF IPs —
 # Caddy must trust these to extract CF-Connecting-IP
 trusted_proxies cloudflare
}

(api_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		-Server
	}
}

(site_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://challenges.cloudflare.com https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://api.orignagta.ca https://api.dev.orignagta.ca https://api.staging.orignagta.ca https://api.stripe.com https://challenges.cloudflare.com https://accounts.google.com https://*.googleapis.com https://pub-f9698d0f50d146bcac0e2dc9eb09de57.r2.dev wss://api.orignagta.ca wss://api.dev.orignagta.ca wss://api.staging.orignagta.ca; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com https://accounts.google.com; worker-src 'self' blob:; frame-ancestors 'self'; manifest-src 'self'"
		-Server
	}
}

(site_cache_rules) {
	@immutable_assets {
		path /assets/* /canvaskit/* /icons/* /splash/* *.js *.mjs *.css *.wasm *.png *.jpg *.jpeg *.webp *.svg *.woff *.woff2 *.ttf *.otf
		not path /flutter_bootstrap.js /flutter_service_worker.js /manifest.json /index.html
	}
	header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

	@app_shell path / /index.html /flutter_bootstrap.js /flutter_service_worker.js /manifest.json
	header @app_shell Cache-Control "no-cache, no-store, must-revalidate"
}

api.orignagta.ca {
	import api_security_headers
	encode zstd gzip

	@cors_allowed header_regexp Origin ^https://(www|dev|staging)\.orignagta\.ca$
	@cors_preflight {
		method OPTIONS
		header_regexp Origin ^https://(www|dev|staging)\.orignagta\.ca$
	}
	@preflight method OPTIONS

	handle @cors_preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, Origin, Accept, X-Requested-With"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	handle @preflight {
		respond "" 204
	}

	handle @cors_allowed {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, Origin, Accept, X-Requested-With"
		header Access-Control-Allow-Credentials "true"
		header Vary "Origin"
		reverse_proxy orignabase:8080 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Max-Age
			header_down -Vary
		}
	}

	reverse_proxy orignabase:8080
}

orignagta.ca, www.orignagta.ca {
	import site_security_headers
	import site_cache_rules
	encode zstd gzip

	# Backend health probe — bypass SPA fallback
	handle /health {
		reverse_proxy orignabase:8080
	}

	root * /var/www/orignagta/production/current
	try_files {path} {path}/ /index.html
	file_server
}

