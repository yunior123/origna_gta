}

api.orignaventures.ca {
  import api_security_headers
  encode zstd gzip

  @cors_allowed header_regexp Origin ^https://(www\.)?orignaventures\.ca$
  @cors_preflight {
    method OPTIONS
    header_regexp Origin ^https://(www\.)?orignaventures\.ca$
  }
  @preflight method OPTIONS

  handle @cors_preflight {
    header Access-Control-Allow-Origin "{http.request.header.Origin}"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization, Stripe-Signature"
    header Access-Control-Max-Age "86400"
    respond "" 204
  }

  handle @preflight {
    respond "" 204
  }

  handle @cors_allowed {
    header Access-Control-Allow-Origin "{http.request.header.Origin}"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization, Stripe-Signature"
    header Vary "Origin"
    reverse_proxy origna-ventures-api:8080 {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Max-Age
      header_down -Vary
    }
  }

  reverse_proxy origna-ventures-api:8080
}

orignaventures.ca, www.orignaventures.ca {
  import site_security_headers
  import site_cache_rules
  encode zstd gzip

  root * /var/www/orignaventures/production/current
  try_files {path} {path}/ /index.html
  file_server
}
