staging.orignagta.ca {
  import site_security_headers
  import site_cache_rules
  encode zstd gzip

  # Backend health probe — bypass SPA fallback
  handle /health {
    reverse_proxy orignabase:8080
  }

  root * /var/www/orignagta/staging/current
  try_files {path} {path}/ /index.html
