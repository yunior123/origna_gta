{
    "version": "0.2.0",
    "configurations": [
        // =====================================================================
        // 🎯 DEFAULT: FULL STACK DEVELOPMENT (Firebase + Stripe + R2)
        // =====================================================================
        {
            "name": "🚀 Full Stack Dev (Default)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/origna_gta",
            "preLaunchTask": "Start All Emulator Services",
            "postDebugTask": "Stop All Emulator Services",
            "toolArgs": [
                "-d", "chrome",
                "--web-port", "3000",
                "--dart-define=ENVIRONMENT=emulator",
                "--dart-define=USE_EMULATORS=true"
            ],
            "env": {
                "ENVIRONMENT": "emulator"
            }
        },
        {
            "name": "🚀 Full Stack Dev (Release)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/origna_gta",
            "preLaunchTask": "Start All Emulator Services",
            "postDebugTask": "Stop All Emulator Services",
            "flutterMode": "release",
            "toolArgs": [
                "-d", "chrome",
                "--web-port", "3000",
                "--dart-define=ENVIRONMENT=emulator",
                "--dart-define=USE_EMULATORS=true"
            ],
            "env": {
                "ENVIRONMENT": "emulator"
            }
        },
        // =====================================================================
        // FLUTTER CONFIGURATIONS
        // =====================================================================
        {
            "name": "🔧 Flutter Emulator (Debug)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/origna_gta",
            "preLaunchTask": "Start Firebase Emulators",
            "postDebugTask": "Stop All Emulator Services",
            "toolArgs": [
                "-d", "chrome",
                "--dart-define=ENVIRONMENT=emulator",
                "--dart-define=USE_EMULATORS=true"
            ],
            "env": {
                "ENVIRONMENT": "emulator"
            }
        },
        {
            "name": "🔧 Flutter Emulator (Release)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/origna_gta",
            "preLaunchTask": "Start Firebase Emulators",
            "postDebugTask": "Stop All Emulator Services",
            "flutterMode": "release",
            "toolArgs": [
                "-d", "chrome",
                "--dart-define=ENVIRONMENT=emulator",
                "--dart-define=USE_EMULATORS=true"
            ],
            "env": {
                "ENVIRONMENT": "emulator"
            }
        },
        {
            "name": "📱 Flutter Emulator (iOS Simulator)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/origna_gta",
            "preLaunchTask": "Start Firebase Emulators",
            "postDebugTask": "Stop All Emulator Services",
            "toolArgs": [
                "--dart-define=ENVIRONMENT=emulator",
                "--dart-define=USE_EMULATORS=true"
            ],
            "env": {
                "ENVIRONMENT": "emulator"
            }
        },
        {
            "name": "🌐 Flutter Production (Debug)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/origna_gta",
            "toolArgs": [
                "-d", "chrome",
                "--dart-define=ENVIRONMENT=production",
                "--dart-define=USE_EMULATORS=false"
            ],
            "env": {
                "ENVIRONMENT": "production"
            }
        },
        {
            "name": "🌐 Flutter Production (Release)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/origna_gta",
            "flutterMode": "release",
            "toolArgs": [
                "-d", "chrome",
                "--dart-define=ENVIRONMENT=production",
                "--dart-define=USE_EMULATORS=false"
            ],
            "env": {
                "ENVIRONMENT": "production"
            }
        },
        // =====================================================================
        // PYTHON FUNCTIONS CONFIGURATIONS
        // =====================================================================
        {
            "name": "🐍 Python: Run All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "functions/tests/",
                "-v",
                "--tb=short"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "FUNCTIONS_EMULATOR": "true",
                "PYTHONPATH": "${workspaceFolder}/functions",
                "PYTEST_ADDOPTS": "-p no:warnings"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "🐍 Python: Current Test File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v",
                "--tb=short"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "FUNCTIONS_EMULATOR": "true",
                "PYTHONPATH": "${workspaceFolder}/functions",
                "PYTEST_ADDOPTS": "-p no:warnings"
            },
            "console": "integratedTerminal",
            "autoFocusTerminal": true
        }
    ],
    "compounds": [
        // Les compounds sont gardés pour référence mais la config par défaut est maintenant en premier
    ]
}
