{
	"version": "2.0.0",
	"tasks": [
		// =====================================================================
		// FLUTTER TASKS
		// =====================================================================
		{
			"label": "Flutter: Run Web (Dev)",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d", "chrome",
				"--web-port", "3000",
				"--dart-define=ENVIRONMENT=dev",
				"--dart-define=ORIGNABASE_URL=https://api.dev.orignagta.ca",
				"--dart-define=FORCE_SEMANTICS=true"
			],
			"options": {
				"cwd": "${workspaceFolder}/origna_gta"
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"group": "flutter"
			}
		},
		{
			"label": "Flutter: Run Web (Staging)",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d", "chrome",
				"--web-port", "3001",
				"--dart-define=ENVIRONMENT=staging",
				"--dart-define=ORIGNABASE_URL=https://api.staging.orignagta.ca",
				"--dart-define=FORCE_SEMANTICS=true"
			],
			"options": {
				"cwd": "${workspaceFolder}/origna_gta"
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"group": "flutter"
			}
		},
		{
			"label": "Flutter: Build Web (Dev)",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build", "web",
				"--debug",
				"--dart-define=ENVIRONMENT=dev",
				"--dart-define=ORIGNABASE_URL=https://api.dev.orignagta.ca",
				"--dart-define=FORCE_SEMANTICS=true"
			],
			"options": {
				"cwd": "${workspaceFolder}/origna_gta"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Flutter: Build Web (Production)",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build", "web",
				"--release",
				"--dart-define=ENVIRONMENT=production",
				"--dart-define=ORIGNABASE_URL=https://api.orignagta.ca"
			],
			"options": {
				"cwd": "${workspaceFolder}/origna_gta"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Flutter: Analyze",
			"type": "shell",
			"command": "flutter analyze --no-fatal-infos",
			"options": {
				"cwd": "${workspaceFolder}/origna_gta"
			},
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Flutter: Test (Unit + Widget)",
			"type": "shell",
			"command": "flutter test",
			"options": {
				"cwd": "${workspaceFolder}/origna_gta"
			},
			"problemMatcher": [],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		// =====================================================================
		// ORIGNABASE — Rust backend
		// =====================================================================
		{
			"label": "OrignaBase: Build (Debug)",
			"type": "shell",
			"command": "cargo build",
			"options": {
				"cwd": "${workspaceFolder}/../orignabase"
			},
			"problemMatcher": "$rustc",
			"group": "build"
		},
		{
			"label": "OrignaBase: Test",
			"type": "shell",
			"command": "cargo test --lib",
			"options": {
				"cwd": "${workspaceFolder}/../orignabase"
			},
			"problemMatcher": "$rustc",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "OrignaBase: SSH Deploy (Dev)",
			"type": "shell",
			"command": "bash ${workspaceFolder}/scripts/deploy_web.sh dev",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "OrignaBase: SSH Deploy (Production)",
			"type": "shell",
			"command": "bash ${workspaceFolder}/scripts/deploy_web.sh production",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		// =====================================================================
		// STRIPE WEBHOOK FORWARDING (local dev only)
		// =====================================================================
		{
			"label": "Stripe: Forward Webhooks (Dev — port 8080)",
			"type": "shell",
			"command": "stripe listen --forward-to localhost:8080/stripe/webhook --events checkout.session.completed,checkout.session.expired,payment_intent.succeeded,payment_intent.payment_failed,charge.refunded,charge.dispute.created,charge.dispute.closed,transfer.reversed,payout.failed,refund.failed,account.updated",
			"isBackground": true,
			"problemMatcher": {
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Ready!"
				}
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"group": "stripe"
			}
		},
		{
			"label": "Stripe: Stop Listener",
			"type": "shell",
			"command": "pkill -9 -f 'stripe' || true",
			"problemMatcher": [],
			"presentation": { "reveal": "silent", "panel": "shared" }
		},
		// =====================================================================
		// E2E PLAYWRIGHT
		// =====================================================================
		{
			"label": "E2E: Run All Tests (Dev)",
			"type": "shell",
			"command": "npx playwright test --config=playwright.config.dev.ts",
			"options": {
				"cwd": "${workspaceFolder}/e2e"
			},
			"problemMatcher": [],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "E2E: Run Tests (UI Mode)",
			"type": "shell",
			"command": "npx playwright test --config=playwright.config.dev.ts --ui",
			"options": {
				"cwd": "${workspaceFolder}/e2e"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		// =====================================================================
		// SEED DATA
		// =====================================================================
		{
			"label": "Seed: All States (Dev)",
			"type": "shell",
			"command": "python3 seed_all_states.py",
			"options": {
				"cwd": "${workspaceFolder}/e2e/scripts/seed"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Seed: Products Only (2000)",
			"type": "shell",
			"command": "python3 seed_orignabase_2000.py",
			"options": {
				"cwd": "${workspaceFolder}/e2e/scripts/seed"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		// =====================================================================
		// CODE AUDIT
		// =====================================================================
		{
			"label": "Run Kimi Code Audit",
			"type": "shell",
			"command": "python audit/runners/audit.py",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build",
			"presentation": { "reveal": "always", "panel": "shared" }
		},
		{
			"label": "Run Qwen3 Coder Audit",
			"type": "shell",
			"command": "python audit/runners/audit_qwen.py",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build",
			"presentation": { "reveal": "always", "panel": "shared" }
		}
	]
}
