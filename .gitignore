# =============================================================================
# OrignaGta .gitignore — Comprehensive
# =============================================================================

# --- OS artifacts ---
.DS_Store
Thumbs.db

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# --- Firebase cache & exports ---
.firebase/
firebase-export-*/
emulator-data/

# --- Runtime data ---
pids
*.pid
*.seed
*.pid.lock

# --- Coverage ---
lib-cov/
coverage/
.nyc_output/

# --- Dependencies ---
node_modules/
bower_components/

# --- Build artifacts ---
build/Release
*.tgz
.yarn-integrity
.lock-wscript
.grunt/

# --- Cache & tooling ---
.npm/
.eslintcache
.node_repl_history

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
venv/
*.egg-info/

# --- Environment variables & secrets ---
.env
.env.local
functions/.env
functions/.env.local
functions/serviceAccountKey.json
functions/serviceAccountKey*.json
functions/stripe.txt

# --- Dependency directories ---
node_modules/

# --- Agent Browser ---
.agent-browser/
e2e-agent-browser/node_modules/

# --- Firebase artifacts (Firebase is GONE — block re-introduction) ---
origna_gta/android/app/google-services.json
origna_gta/ios/GoogleService-Info.plist
origna_gta/ios/Pods/
origna_gta/macos/Pods/

# --- Flutter build/test artifacts ---
origna_gta/build/
origna_gta/.dart_tool/
origna_gta/test-results/
origna_gta/.gradle-home/
origna_gta/nanobanana-output/

# --- Test results (root) ---
test-results/

# --- Pre-push hooks ---
scripts/pre_push_validation.sh

# --- Audit output & cache ---
audit/output/
audit/.doc_cache/
functions/visual_audit/

# --- Backup / temporary files ---
*.bak
*.backup
*.orig
*.swp
*~

# --- Credentials / secrets ---
TOOLS.md

# --- Telegram bot (contains secrets) ---
telegram_bot/
telegram_bot.py

# --- OrignaBase Rust build artifacts ---
orignabase/target/
orignabase/*.profraw
orignabase/data/keys/
orignabase/fuzz/target/
orignabase/Helvetica-*.ttf
orignabase/orignabase.toml
orignabase/secrets-*.json
orignabase/docker/.env
orignabase/docker/.env.staging
orignabase/docker/.env.prod

# --- IDE ---
# .vscode/ is kept for shared tasks/settings
.worktrees/
.playwright-mcp/

# AI-sync generated
GEMINI.md

# --- OrignaVentures ---
origna_ventures/build/
origna_ventures/.dart_tool/
origna_ventures/.flutter-plugins
origna_ventures/.flutter-plugins-dependencies
origna_ventures/*.iml
origna_ventures/ios/Pods/
origna_ventures/macos/Pods/
origna_ventures/backend/storage/
origna_ventures/backend/venv/
origna_ventures/backend/__pycache__/
origna_ventures/backend/*.db
origna_ventures/backend/.env
origna_ventures/output/
origna_ventures/images/
origna_gta/build/
