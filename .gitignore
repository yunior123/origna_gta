# =============================================================================
# OrignaGTA Monorepo .gitignore — Comprehensive
# =============================================================================

# --- OS artifacts ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Runtime data ---
pids
*.pid
*.seed
*.pid.lock

# --- Coverage ---
lib-cov/
coverage/
.nyc_output/

# --- Dependencies ---
node_modules/
bower_components/

# --- Build artifacts ---
build/Release
*.tgz
.yarn-integrity
.lock-wscript
.grunt/

# --- Cache & tooling ---
.npm/
.eslintcache
.node_repl_history

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
venv/
.venv/
*.egg-info/

# --- Environment variables & secrets ---
.env
.env.local
.env.*.local
*.env
!.env.example
!.env.dev
!.env.local.example
*.pem
*.key
*.jks
*.keystore
*-key.json
credentials*
service-account*.json
secrets/
secrets-*.json
TOOLS.md

# --- Agent Browser ---
.agent-browser/
e2e-agent-browser/node_modules/

# --- Firebase artifacts (Firebase is GONE — block re-introduction) ---
.firebase/
firebase-export-*/
emulator-data/
firebase-debug.log*
firebase-debug.*.log*
origna_gta/android/app/google-services.json
origna_gta/ios/GoogleService-Info.plist
origna_gta/ios/Pods/
origna_gta/macos/Pods/

# --- OrignaGTA Flutter ---
origna_gta/build/
origna_gta/.dart_tool/
origna_gta/.pub-cache/
origna_gta/.pub/
origna_gta/.flutter-plugins
origna_gta/.flutter-plugins-dependencies
origna_gta/test-results/
origna_gta/.gradle-home/
origna_gta/nanobanana-output/
origna_gta/pubspec_overrides.yaml
origna_gta/coverage-html/
origna_gta/android/key.properties
origna_gta/android/app/debug/
origna_gta/android/app/profile/
origna_gta/android/app/release/

# --- OrignaVentures Flutter + Python ---
origna_ventures/build/
origna_ventures/.dart_tool/
origna_ventures/.flutter-plugins
origna_ventures/.flutter-plugins-dependencies
origna_ventures/*.iml
origna_ventures/ios/Pods/
origna_ventures/macos/Pods/
origna_ventures/backend/storage/
origna_ventures/backend/venv/
origna_ventures/backend/.venv/
origna_ventures/backend/__pycache__/
origna_ventures/backend/*.db
origna_ventures/backend/.env
origna_ventures/output/
origna_ventures/images/
origna_ventures/coverage/

# --- OrignaBase Rust ---
orignabase/target/
orignabase/*.profraw
orignabase/data/keys/
orignabase/fuzz/target/
orignabase/Helvetica-*.ttf
orignabase/orignabase.toml
orignabase/secrets-*.json
orignabase/docker/.env
orignabase/docker/.env.staging
orignabase/docker/.env.prod
orignabase/local_test_data/

# --- Test results (root) ---
test-results/

# --- E2E ---
e2e/node_modules/
e2e/dist/
e2e/test-results/

# --- Audit output & cache ---
audit/output/
audit/.doc_cache/
functions/visual_audit/

# --- Pre-push hooks ---
scripts/pre_push_validation.sh

# --- Backup / temporary files ---
*.bak
*.backup
*.orig
*.swp
*.swo
*~

# --- Telegram bot (contains secrets) ---
telegram_bot/
telegram_bot.py

# --- IDE ---
.idea/
*.iml
# .vscode/ is kept for shared tasks/settings
.worktrees/
.playwright-mcp/

# --- AI tool artifacts ---
.agent/
.kilo/
.opencode/
GEMINI.md
extracted_images/
data.ms/
meili_data/
data/
dumps/
