# =============================================================================
# OrignaGta .gitignore — Comprehensive
# =============================================================================

# --- OS artifacts ---
.DS_Store
Thumbs.db

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# --- Firebase cache & exports ---
.firebase/
firebase-export-*/
emulator-data/

# --- Runtime data ---
pids
*.pid
*.seed
*.pid.lock

# --- Coverage ---
lib-cov/
coverage/
.nyc_output/

# --- Dependencies ---
node_modules/
bower_components/

# --- Build artifacts ---
build/Release
*.tgz
.yarn-integrity
.lock-wscript
.grunt/

# --- Cache & tooling ---
.npm/
.eslintcache
.node_repl_history

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
venv/
*.egg-info/

# --- Environment variables & secrets ---
.env
.env.local
functions/.env
functions/.env.local
functions/serviceAccountKey.json
functions/serviceAccountKey*.json
functions/stripe.txt

# --- Dependency directories ---
node_modules/

# --- Agent Browser ---
.agent-browser/
e2e-agent-browser/node_modules/

# --- Flutter build/test artifacts ---
origna_gta/build/
origna_gta/.dart_tool/
origna_gta/test-results/
origna_gta/.gradle-home/
origna_gta/nanobanana-output/

# --- Test results (root) ---
test-results/

# --- Audit output & cache ---
audit/output/
audit/.doc_cache/
functions/visual_audit/

# --- Backup / temporary files ---
*.bak
*.backup
*.orig
*.swp
*~

# --- Credentials / secrets ---
TOOLS.md

# --- Telegram bot (contains secrets) ---
telegram_bot/
telegram_bot.py

# --- IDE ---
# .vscode/ is kept for shared tasks/settings
.worktrees/
.playwright-mcp/
