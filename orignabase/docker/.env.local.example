# .env.local.example — Local development environment template
# Copy to .env: cp .env.local.example .env
# ALL values are INSECURE DEFAULTS for localhost only — never use in production

# --- PostgreSQL ---
POSTGRES_USER=orignabase
POSTGRES_PASSWORD=orignabase_dev
POSTGRES_DB=orignabase

# --- Meilisearch ---
MEILI_ENV=development
MEILI_MASTER_KEY=dev-meili-key-insecure

# --- OrignaBase Server ---
OB_HOST=0.0.0.0
OB_PORT=8080
OB_BASE_URL=http://localhost:8080
OB_TEST_MODE=1

# --- Database (Docker internal DNS — NOT localhost) ---
OB_DATABASE__URL=REDACTED_SECRET/orignabase

# --- Auth ---
OB_AUTH__JWT_SECRET=dev-jwt-secret-not-for-production
OB_AUTH__ACCESS_TOKEN_TTL_SECS=3600
OB_AUTH__REFRESH_TOKEN_TTL_SECS=604800
OB_AUTH__GOOGLE_CLIENT_ID=
OB_AUTH__GOOGLE_CLIENT_SECRET=

# --- Security ---
OB_SECURITY__RULES_PATH=/etc/orignabase/rules.ob

# --- Search (Docker internal DNS) ---
OB_SEARCH__URL=http://meilisearch:7700
OB_SEARCH__API_KEY=dev-meili-key-insecure

# --- Stripe (test mode — get from `stripe-cli-env.sh test`) ---
# Run: eval "$(./scripts/stripe-cli-env.sh test)" to populate these
OB_SECRETS__STRIPE_SECRET_KEY=
OB_SECRETS__STRIPE_WEBHOOK_SECRET=
# For webhook forwarding: stripe listen --forward-to localhost:8080/api/webhooks/stripe
# Copy the whsec_* value printed by stripe listen into STRIPE_WEBHOOK_SECRET above

# --- Email (optional — leave empty for no email sending) ---
OB_SECRETS__POSTAL_API_KEY=

# --- Geocoding (optional) ---
OB_SECRETS__GEOAPIFY_API_KEY=

# --- DocuSeal (local/self-hosted signatures) ---
DOCUSEAL_POSTGRES_USER=docuseal
DOCUSEAL_POSTGRES_PASSWORD=docuseal_dev
DOCUSEAL_POSTGRES_DB=docuseal
DOCUSEAL_DATABASE_URL=REDACTED_SECRET/docuseal
# Generate production value with: openssl rand -hex 64
DOCUSEAL_SECRET_KEY_BASE=dev-docuseal-secret-key-base-not-for-production-dev-docuseal-secret-key-base-not-for-production
DOCUSEAL_FORCE_SSL=false
DOCUSEAL_HOST=http://localhost
DOCUSEAL_SMTP_ADDRESS=
DOCUSEAL_SMTP_PORT=587
DOCUSEAL_SMTP_DOMAIN=orignagta.ca
DOCUSEAL_SMTP_USERNAME=
DOCUSEAL_SMTP_PASSWORD=
DOCUSEAL_SMTP_AUTHENTICATION=plain
DOCUSEAL_SMTP_FROM=signatures@orignagta.ca
DOCUSEAL_SMTP_ENABLE_STARTTLS=true
DOCUSEAL_SMTP_SSL_VERIFY=true
